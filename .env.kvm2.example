# ==============================================================================
# SupoClip - Configuração Otimizada para Hostinger VPS KVM 2 (2 vCPU, 8 GB RAM)
# ==============================================================================

# 1. Transcrição (NÃO USE WHISPER LOCAL NO KVM 2 - ele travaria os 2 vCPUs)
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLY_AI_API_KEY=coloque_sua_chave_assemblyai_aqui
TRANSCRIPTION_LANGUAGE=pt

# 2. IA para Análise e Viralidade (Gemini 2.5 Flash / 1.5 Flash é ultra rápido e barato)
LLM=google-gla:gemini-3.8-flash
GOOGLE_API_KEY=coloque_sua_chave_google_gemini_aqui

# Se preferir OpenAI:
# LLM=openai:gpt-4o-mini
# OPENAI_API_KEY=sua_chave_openai_aqui

# Se preferir Anthropic Claude para o chat do editor:
# AI_EDIT_MODEL=anthropic:claude-3-5-sonnet
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# 3. Otimizações de CPU e Renderização para Hostinger KVM 2
BACKEND_CPU_ONLY=true
BACKEND_PLATFORM=linux/amd64
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
FINAL_VIDEO_CRF=20

# 4. Modos de Processamento e Limites
DEFAULT_PROCESSING_MODE=fast
MAX_CLIPS=10
FAST_MODE_MAX_CLIPS=10
SPEAKER_FRAMING=true
HOOK_FIRST_TEASER=false
MAX_VIDEO_DURATION=18000
PRO_YOUTUBE_MAX_VIDEO_DURATION=18000
SCALE_YOUTUBE_MAX_VIDEO_DURATION=18000
MAX_VIDEO_UPLOAD_BYTES=4000000000
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES=4000000000

# 5. Segurança e Autenticação (Gere strings seguras com `openssl rand -hex 32`)
BETTER_AUTH_SECRET=substitua_por_uma_string_aleatoria_longa_1
BACKEND_AUTH_SECRET=substitua_por_uma_string_aleatoria_longa_2
APP_SETTINGS_ENCRYPTION_KEY=substitua_por_uma_string_aleatoria_longa_3
DISABLE_SIGN_UP=false

# 6. URLs e Domínio (Ajuste para o IP da sua VPS ou seu domínio com HTTPS)
FRONTEND_PORT=3107
NEXT_PUBLIC_APP_URL=http://187.41.96.205:3107
BETTER_AUTH_URL=http://187.41.96.205:3107
NEXT_PUBLIC_API_URL=http://187.41.96.205:8000
CORS_ORIGINS=http://187.41.96.205:3107,http://187.41.96.205:8000,http://localhost:3107

# 7. Modo Self-Host (Desativa cobranças Stripe e libera todas as funções)
SELF_HOST=true
MEDIA_STORAGE=local

# 8. Produção Standalone (economiza ~80% de RAM no Next.js)
FRONTEND_BUILD_TARGET=runner
